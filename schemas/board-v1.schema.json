{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumina.invalid/schema/board-v1.schema.json",
  "title": "Alumina board package identity",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "display_name",
    "revision",
    "chip",
    "target",
    "cores",
    "flash_bytes",
    "psram_bytes",
    "service_core",
    "realtime_core",
    "qualification",
    "implementation",
    "hardware_available",
    "armable"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "chip": { "enum": ["esp32", "esp32s3"] },
    "target": {
      "enum": ["xtensa-esp32-none-elf", "xtensa-esp32s3-none-elf"]
    },
    "cores": { "type": "integer", "minimum": 2 },
    "flash_bytes": { "type": "integer", "minimum": 0 },
    "psram_bytes": { "type": "integer", "minimum": 0 },
    "service_core": { "type": "integer", "minimum": 0 },
    "realtime_core": { "type": "integer", "minimum": 0 },
    "qualification": {
      "enum": [
        "described",
        "compiles",
        "bench",
        "motion-qualified",
        "production-qualified"
      ]
    },
    "implementation": { "enum": ["planned", "late-stub", "implemented"] },
    "hardware_available": { "type": "boolean" },
    "firmware_feature": {
      "type": "string",
      "pattern": "^board-[a-z0-9-]+$"
    },
    "armable": { "type": "boolean" }
  }
}
