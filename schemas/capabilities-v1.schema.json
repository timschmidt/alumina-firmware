{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumina.invalid/schema/capabilities-v1.schema.json",
  "title": "Alumina portable board capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "display_name",
    "revision",
    "chip",
    "target",
    "cores",
    "service_core",
    "realtime_core",
    "flash_bytes",
    "psram_bytes",
    "qualification",
    "implementation",
    "hardware_available",
    "firmware_feature",
    "armable",
    "resources",
    "aliases",
    "buses",
    "devices"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "chip": { "enum": ["esp32", "esp32s3"] },
    "target": {
      "enum": ["xtensa-esp32-none-elf", "xtensa-esp32s3-none-elf"]
    },
    "cores": { "type": "integer", "minimum": 2 },
    "service_core": { "type": "integer", "minimum": 0 },
    "realtime_core": { "type": "integer", "minimum": 0 },
    "flash_bytes": { "type": "integer", "minimum": 0 },
    "psram_bytes": { "type": "integer", "minimum": 0 },
    "qualification": {
      "enum": [
        "described",
        "compiles",
        "bench",
        "motion-qualified",
        "production-qualified"
      ]
    },
    "implementation": { "enum": ["planned", "late-stub", "implemented"] },
    "hardware_available": { "type": "boolean" },
    "firmware_feature": {
      "type": ["string", "null"],
      "pattern": "^board-[a-z0-9-]+$"
    },
    "armable": { "type": "boolean" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "safe_value", "hazardous_output"],
        "properties": {
          "id": { "$ref": "#/$defs/resourceId" },
          "owner": { "enum": ["service", "realtime"] },
          "safe_value": {
            "enum": [
              "not-applicable",
              "high-impedance",
              "low",
              "high",
              "engine-image"
            ]
          },
          "hazardous_output": { "type": "boolean" }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "resource"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "resource": { "$ref": "#/$defs/resourceId" }
        }
      }
    },
    "buses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "kind", "owner", "maximum_frequency_hz", "pins"],
        "properties": {
          "resource": { "$ref": "#/$defs/resourceId" },
          "kind": { "enum": ["i2c", "spi", "uart"] },
          "owner": { "enum": ["service", "realtime"] },
          "maximum_frequency_hz": { "type": "integer", "minimum": 1 },
          "pins": {
            "type": "array",
            "items": { "$ref": "#/$defs/resourceId" }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "owner", "bus", "route", "support"],
        "properties": {
          "resource": { "$ref": "#/$defs/resourceId" },
          "owner": { "enum": ["service", "realtime"] },
          "bus": {
            "oneOf": [
              { "$ref": "#/$defs/resourceId" },
              { "type": "null" }
            ]
          },
          "route": { "$ref": "#/$defs/deviceRoute" },
          "support": { "enum": ["described", "compiles", "bench", "qualified"] }
        }
      }
    }
  },
  "$defs": {
    "resourceId": {
      "oneOf": [
        { "$ref": "#/$defs/indexedResource" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "engine", "bit"],
          "properties": {
            "kind": { "const": "i2s-out" },
            "engine": { "type": "integer", "minimum": 0, "maximum": 255 },
            "bit": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unit", "channel"],
          "properties": {
            "kind": { "const": "adc" },
            "unit": { "type": "integer", "minimum": 0, "maximum": 255 },
            "channel": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "group", "index"],
          "properties": {
            "kind": { "const": "timer" },
            "group": { "type": "integer", "minimum": 0, "maximum": 255 },
            "index": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "engine", "channel"],
          "properties": {
            "kind": { "const": "timed-output" },
            "engine": { "type": "integer", "minimum": 0, "maximum": 255 },
            "channel": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      ]
    },
    "indexedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": {
          "enum": [
            "gpio",
            "i2s",
            "rmt",
            "i2c",
            "spi",
            "uart",
            "pcnt",
            "dma",
            "twai",
            "storage",
            "radio",
            "safety-input",
            "device"
          ]
        },
        "index": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "deviceRoute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["dedicated", "uart"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "address"],
          "properties": {
            "kind": { "const": "i2c-address" },
            "address": { "type": "integer", "minimum": 0, "maximum": 127 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource"],
          "properties": {
            "kind": { "const": "spi-chip-select" },
            "resource": { "$ref": "#/$defs/resourceId" }
          }
        }
      ]
    }
  }
}
